# Ollama Configuration
# All variables are optional; defaults: gemma4:e4b (text and vision), http://localhost:11434.
# Example: use the larger Gemma 4 12B for better extraction if you have the RAM.
OLLAMA_MODEL_NAME="gemma4:12b"
OLLAMA_VISION_MODEL_NAME="gemma4:e4b"
OLLAMA_API_URL="http://localhost:11434"
